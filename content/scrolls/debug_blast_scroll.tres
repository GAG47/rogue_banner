[gd_resource type="Resource" script_class="ScrollDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/definitions/scroll_definition.gd" id="1_scroll"]
[ext_resource type="Script" path="res://scripts/rules/targeting_definition.gd" id="2_targeting"]
[ext_resource type="Script" path="res://scripts/effects/damage_effect_definition.gd" id="3_damage"]

[sub_resource type="Resource" id="Targeting_enemy_cell"]
script = ExtResource("2_targeting")
target_kind = 0
target_relation = 2
minimum_range = 1
maximum_range = 5
minimum_targets = 1
maximum_targets = 1
requires_line_of_sight = true

[sub_resource type="Resource" id="Effect_damage"]
script = ExtResource("3_damage")
target_source = 1
flat_amount = 7
source_attribute = 1
attribute_multiplier = 0.0

[resource]
script = ExtResource("1_scroll")
content_id = &"debug_blast_scroll"
display_name = "爆裂卷轴"
max_stack_size = 2
targeting = SubResource("Targeting_enemy_cell")
effects = [SubResource("Effect_damage")]

