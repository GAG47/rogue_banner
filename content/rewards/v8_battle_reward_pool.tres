[gd_resource type="Resource" script_class="RewardPoolDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/rewards/reward_pool_definition.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/rewards/reward_entry_definition.gd" id="2_entry"]
[ext_resource type="Script" path="res://scripts/rewards/currency_reward_definition.gd" id="3_gold"]
[ext_resource type="Script" path="res://scripts/rewards/art_reward_definition.gd" id="4_art"]
[ext_resource type="Script" path="res://scripts/rewards/scroll_reward_definition.gd" id="5_scroll"]
[ext_resource type="Script" path="res://scripts/rewards/healing_reward_definition.gd" id="6_heal"]
[ext_resource type="Resource" path="res://content/arts/debug_shove.tres" id="7_shove"]
[ext_resource type="Resource" path="res://content/scrolls/debug_blast_scroll.tres" id="8_scroll"]

[sub_resource type="Resource" id="Payload_gold"]
script = ExtResource("3_gold")
amount = 20

[sub_resource type="Resource" id="Entry_gold"]
script = ExtResource("2_entry")
payload = SubResource("Payload_gold")
weight = 1.0
allow_duplicate = true

[sub_resource type="Resource" id="Payload_art"]
script = ExtResource("4_art")
art_definition = ExtResource("7_shove")

[sub_resource type="Resource" id="Entry_art"]
script = ExtResource("2_entry")
payload = SubResource("Payload_art")
weight = 1.0
allow_duplicate = true

[sub_resource type="Resource" id="Payload_scroll"]
script = ExtResource("5_scroll")
scroll_definition = ExtResource("8_scroll")
quantity = 1

[sub_resource type="Resource" id="Entry_scroll"]
script = ExtResource("2_entry")
payload = SubResource("Payload_scroll")
weight = 1.0
allow_duplicate = true

[sub_resource type="Resource" id="Payload_heal"]
script = ExtResource("6_heal")
amount = 5

[sub_resource type="Resource" id="Entry_heal"]
script = ExtResource("2_entry")
payload = SubResource("Payload_heal")
weight = 1.0
allow_duplicate = true

[resource]
script = ExtResource("1_pool")
content_id = &"v8_battle_reward_pool"
display_name = "战斗缴获"
offer_rule = 3
option_count = 3
entries = [SubResource("Entry_gold"), SubResource("Entry_art"), SubResource("Entry_scroll"), SubResource("Entry_heal")]
