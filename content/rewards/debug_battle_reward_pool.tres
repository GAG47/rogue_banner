[gd_resource type="Resource" script_class="RewardPoolDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/rewards/reward_pool_definition.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/rewards/reward_entry_definition.gd" id="2_entry"]
[ext_resource type="Script" path="res://scripts/rewards/art_reward_definition.gd" id="3_art_reward"]
[ext_resource type="Script" path="res://scripts/rewards/currency_reward_definition.gd" id="4_gold_reward"]
[ext_resource type="Script" path="res://scripts/rewards/healing_reward_definition.gd" id="5_heal_reward"]
[ext_resource type="Resource" path="res://content/arts/debug_run_strike.tres" id="6_art"]

[sub_resource type="Resource" id="Payload_art"]
script = ExtResource("3_art_reward")
kind = 1
art_definition = ExtResource("6_art")

[sub_resource type="Resource" id="Entry_art"]
script = ExtResource("2_entry")
payload = SubResource("Payload_art")
weight = 1.0
allow_duplicate = true

[sub_resource type="Resource" id="Payload_gold"]
script = ExtResource("4_gold_reward")
kind = 0
amount = 30

[sub_resource type="Resource" id="Entry_gold"]
script = ExtResource("2_entry")
payload = SubResource("Payload_gold")
weight = 1.0

[sub_resource type="Resource" id="Payload_heal"]
script = ExtResource("5_heal_reward")
kind = 5
amount = 4

[sub_resource type="Resource" id="Entry_heal"]
script = ExtResource("2_entry")
payload = SubResource("Payload_heal")
weight = 1.0

[resource]
script = ExtResource("1_pool")
content_id = &"debug_battle_reward_pool"
display_name = "调试战斗奖励"
offer_rule = 0
option_count = 3
entries = [SubResource("Entry_art"), SubResource("Entry_gold"), SubResource("Entry_heal")]

