[gd_resource type="Resource" script_class="RewardPoolDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/rewards/reward_pool_definition.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/rewards/reward_entry_definition.gd" id="2_entry"]
[ext_resource type="Script" path="res://scripts/rewards/relic_reward_definition.gd" id="3_relic_reward"]
[ext_resource type="Script" path="res://scripts/rewards/unit_reward_definition.gd" id="4_unit_reward"]
[ext_resource type="Resource" path="res://content/relics/debug_resolute_banner.tres" id="5_relic"]
[ext_resource type="Resource" path="res://content/units/debug_run_recruit.tres" id="6_unit"]

[sub_resource type="Resource" id="Payload_relic"]
script = ExtResource("3_relic_reward")
kind = 2
relic_definition = ExtResource("5_relic")

[sub_resource type="Resource" id="Entry_relic"]
script = ExtResource("2_entry")
payload = SubResource("Payload_relic")
weight = 1.0
price = 20

[sub_resource type="Resource" id="Payload_unit"]
script = ExtResource("4_unit_reward")
kind = 4
unit_definition = ExtResource("6_unit")

[sub_resource type="Resource" id="Entry_unit"]
script = ExtResource("2_entry")
payload = SubResource("Payload_unit")
weight = 1.0
price = 25

[resource]
script = ExtResource("1_pool")
content_id = &"debug_shop_reward_pool"
display_name = "调试商店"
offer_rule = 2
option_count = 2
entries = [SubResource("Entry_relic"), SubResource("Entry_unit")]

