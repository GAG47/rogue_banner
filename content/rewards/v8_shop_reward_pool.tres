[gd_resource type="Resource" script_class="RewardPoolDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/rewards/reward_pool_definition.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/rewards/reward_entry_definition.gd" id="2_entry"]
[ext_resource type="Script" path="res://scripts/rewards/art_reward_definition.gd" id="3_art"]
[ext_resource type="Script" path="res://scripts/rewards/unit_reward_definition.gd" id="4_unit"]
[ext_resource type="Script" path="res://scripts/rewards/scroll_reward_definition.gd" id="5_scroll"]
[ext_resource type="Resource" path="res://content/arts/debug_focus.tres" id="6_focus"]
[ext_resource type="Resource" path="res://content/units/debug_run_recruit.tres" id="7_recruit"]
[ext_resource type="Resource" path="res://content/scrolls/debug_blast_scroll.tres" id="8_scroll"]

[sub_resource type="Resource" id="Payload_art"]
script = ExtResource("3_art")
art_definition = ExtResource("6_focus")

[sub_resource type="Resource" id="Entry_art"]
script = ExtResource("2_entry")
payload = SubResource("Payload_art")
weight = 1.0
allow_duplicate = true
price = 15

[sub_resource type="Resource" id="Payload_unit"]
script = ExtResource("4_unit")
unit_definition = ExtResource("7_recruit")

[sub_resource type="Resource" id="Entry_unit"]
script = ExtResource("2_entry")
payload = SubResource("Payload_unit")
weight = 1.0
allow_duplicate = true
price = 25

[sub_resource type="Resource" id="Payload_scroll"]
script = ExtResource("5_scroll")
scroll_definition = ExtResource("8_scroll")
quantity = 1

[sub_resource type="Resource" id="Entry_scroll"]
script = ExtResource("2_entry")
payload = SubResource("Payload_scroll")
weight = 1.0
allow_duplicate = true
price = 10

[resource]
script = ExtResource("1_pool")
content_id = &"v8_shop_reward_pool"
display_name = "行军商店"
offer_rule = 2
option_count = 3
entries = [SubResource("Entry_art"), SubResource("Entry_unit"), SubResource("Entry_scroll")]
