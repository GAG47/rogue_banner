[gd_resource type="Resource" script_class="EncounterDefinition" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/map/encounter_definition.gd" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/map/enemy_spawn_definition.gd" id="2_spawn"]
