[gd_resource type="Resource" script_class="RelicDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/definitions/relic_definition.gd" id="1_relic"]
[ext_resource type="Script" path="res://scripts/rules/trigger_definition.gd" id="2_trigger"]
[ext_resource type="Script" path="res://scripts/rules/event_unit_side_condition_definition.gd" id="3_condition"]
[ext_resource type="Script" path="res://scripts/effects/shield_effect_definition.gd" id="4_shield"]

[sub_resource type="Resource" id="Condition_player_target"]
script = ExtResource("3_condition")
event_unit_role = 1
relation = 0

[sub_resource type="Resource" id="Effect_shield"]
script = ExtResource("4_shield")
target_source = 3
flat_amount = 2
source_attribute = 1
attribute_multiplier = 0.0

[sub_resource type="Resource" id="Trigger_damage"]
script = ExtResource("2_trigger")
event_kind = 1
conditions = [SubResource("Condition_player_target")]
effects = [SubResource("Effect_shield")]
maximum_triggers_per_action = 1

[resource]
script = ExtResource("1_relic")
content_id = &"debug_resolute_banner"
display_name = "坚毅战旗"
maximum_copies = 1
passive_triggers = [SubResource("Trigger_damage")]

