[gd_resource type="Resource" script_class="ArtDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/definitions/art_definition.gd" id="1_art"]
[ext_resource type="Script" path="res://scripts/rules/targeting_definition.gd" id="2_targeting"]
[ext_resource type="Script" path="res://scripts/effects/damage_effect_definition.gd" id="3_damage"]

[sub_resource type="Resource" id="Targeting_enemy"]
script = ExtResource("2_targeting")
target_kind = 0
target_relation = 2
minimum_range = 1
maximum_range = 1
minimum_targets = 1
maximum_targets = 1
requires_line_of_sight = true

[sub_resource type="Resource" id="Effect_damage"]
script = ExtResource("3_damage")
target_source = 1
flat_amount = 0
source_attribute = 1
attribute_multiplier = 1.0

[resource]
script = ExtResource("1_art")
content_id = &"debug_strike"
display_name = "突击"
category = 0
ap_cost = 2
cooldown = 1
targeting = SubResource("Targeting_enemy")
effects = [SubResource("Effect_damage")]
