[gd_resource type="Resource" script_class="ArtDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/definitions/art_definition.gd" id="1_art"]
[ext_resource type="Script" path="res://scripts/rules/targeting_definition.gd" id="2_targeting"]
[ext_resource type="Script" path="res://scripts/effects/shield_effect_definition.gd" id="3_shield"]

[sub_resource type="Resource" id="Targeting_self"]
script = ExtResource("2_targeting")
target_kind = 1
target_relation = 0
minimum_range = 0
maximum_range = 0
minimum_targets = 1
maximum_targets = 1
requires_line_of_sight = false

[sub_resource type="Resource" id="Effect_shield"]
script = ExtResource("3_shield")
target_source = 1
flat_amount = 3
source_attribute = 1
attribute_multiplier = 0.0

[resource]
script = ExtResource("1_art")
content_id = &"debug_guard"
display_name = "架盾"
category = 1
ap_cost = 1
cooldown = 2
targeting = SubResource("Targeting_self")
effects = [SubResource("Effect_shield")]
