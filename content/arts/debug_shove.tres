[gd_resource type="Resource" script_class="ArtDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/definitions/art_definition.gd" id="1_art"]
[ext_resource type="Script" path="res://scripts/rules/targeting_definition.gd" id="2_targeting"]
[ext_resource type="Script" path="res://scripts/effects/forced_movement_effect_definition.gd" id="3_push"]

[sub_resource type="Resource" id="Targeting_enemy"]
script = ExtResource("2_targeting")
target_kind = 0
target_relation = 2
minimum_range = 1
maximum_range = 1
requires_line_of_sight = true

[sub_resource type="Resource" id="Effect_push"]
script = ExtResource("3_push")
target_source = 1
distance = 1

[resource]
script = ExtResource("1_art")
content_id = &"debug_shove"
display_name = "推击"
category = 1
ap_cost = 1
cooldown = 0
targeting = SubResource("Targeting_enemy")
effects = [SubResource("Effect_push")]
