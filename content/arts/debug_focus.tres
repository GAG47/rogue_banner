[gd_resource type="Resource" script_class="ArtDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/definitions/art_definition.gd" id="1_art"]
[ext_resource type="Script" path="res://scripts/rules/targeting_definition.gd" id="2_targeting"]
[ext_resource type="Script" path="res://scripts/effects/apply_buff_effect_definition.gd" id="3_apply_buff"]
[ext_resource type="Resource" path="res://content/buffs/debug_battle_focus.tres" id="4_buff"]

[sub_resource type="Resource" id="Targeting_self"]
script = ExtResource("2_targeting")
target_kind = 1
target_relation = 0
minimum_range = 0
maximum_range = 0
minimum_targets = 1
maximum_targets = 1
requires_line_of_sight = false

[sub_resource type="Resource" id="Effect_apply_buff"]
script = ExtResource("3_apply_buff")
target_source = 1
buff = ExtResource("4_buff")

[resource]
script = ExtResource("1_art")
content_id = &"debug_focus"
display_name = "专注"
category = 1
ap_cost = 1
cooldown = 0
targeting = SubResource("Targeting_self")
effects = [SubResource("Effect_apply_buff")]
