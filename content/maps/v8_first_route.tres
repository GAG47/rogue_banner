[ext_resource type="Script" path="res://scripts/map/event_map_node_definition.gd" id="6_event_node"]
[ext_resource type="Script" path="res://scripts/map/camp_map_node_definition.gd" id="7_camp_node"]
[ext_resource type="Script" path="res://scripts/map/chest_map_node_definition.gd" id="8_chest_node"]
[ext_resource type="Resource" path="res://content/encounters/v8_standard_encounter.tres" id="9_standard"]
[ext_resource type="Resource" path="res://content/encounters/v8_elite_encounter.tres" id="10_elite"]
[ext_resource type="Resource" path="res://content/encounters/v8_boss_encounter.tres" id="11_boss"]
