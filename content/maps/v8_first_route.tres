maximum_copies = 1

[resource]
script = ExtResource("1_map")
content_id = &"v8_first_route"
display_name = "第一远征路线"
layer_count = 6
minimum_nodes_per_layer = 1
maximum_nodes_per_layer = 1
extra_connection_chance = 0.0
start_node = SubResource("Node_start")
boss_node = SubResource("Node_boss")
node_pool = [SubResource("Entry_battle"), SubResource("Entry_shop"), SubResource("Entry_event"), SubResource("Entry_camp"), SubResource("Entry_chest"), SubResource("Entry_elite")]
