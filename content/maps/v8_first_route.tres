[ext_resource type="Resource" path="res://content/map_events/v8_camp.tres" id="15_camp"]

[sub_resource type="Resource" id="Node_start"]
script = ExtResource("2_node")
content_id = &"v8_route_start"
display_name = "远征起点"
kind = 0

[sub_resource type="Resource" id="Node_battle"]
script = ExtResource("4_encounter_node")
content_id = &"v8_route_battle"
display_name = "前线交锋"
kind = 1
encounter = ExtResource("9_standard")

[sub_resource type="Resource" id="Node_shop"]
script = ExtResource("5_shop_node")
content_id = &"v8_route_shop"
display_name = "行商营帐"
kind = 4
reward_pool = ExtResource("12_shop_pool")

[sub_resource type="Resource" id="Node_event"]
script = ExtResource("6_event_node")
content_id = &"v8_route_event"
display_name = "岔路奇遇"
kind = 7
event_definition = ExtResource("14_event")

[sub_resource type="Resource" id="Node_camp"]
script = ExtResource("7_camp_node")
content_id = &"v8_route_camp"
display_name = "行军营地"
kind = 5
camp_definition = ExtResource("15_camp")

[sub_resource type="Resource" id="Node_chest"]
script = ExtResource("8_chest_node")
content_id = &"v8_route_chest"
display_name = "遗落军箱"
kind = 6
reward_pool = ExtResource("13_chest_pool")

[sub_resource type="Resource" id="Node_elite"]
script = ExtResource("4_encounter_node")
content_id = &"v8_route_elite"
display_name = "重兵防线"
kind = 2
encounter = ExtResource("10_elite")

[sub_resource type="Resource" id="Node_boss"]
script = ExtResource("4_encounter_node")
content_id = &"v8_route_boss"
display_name = "旗主决战"
kind = 3
encounter = ExtResource("11_boss")

[sub_resource type="Resource" id="Entry_battle"]
script = ExtResource("3_entry")
node_definition = SubResource("Node_battle")
minimum_layer = 1
maximum_layer = 1
minimum_copies = 1
maximum_copies = 1

[sub_resource type="Resource" id="Entry_shop"]
script = ExtResource("3_entry")
node_definition = SubResource("Node_shop")
minimum_layer = 2
maximum_layer = 2
minimum_copies = 1
maximum_copies = 1

[sub_resource type="Resource" id="Entry_event"]
script = ExtResource("3_entry")
node_definition = SubResource("Node_event")
