maximum_layer = 3
minimum_copies = 1
maximum_copies = 1

[sub_resource type="Resource" id="Entry_camp"]
script = ExtResource("3_entry")
node_definition = SubResource("Node_camp")
minimum_layer = 4
maximum_layer = 4
